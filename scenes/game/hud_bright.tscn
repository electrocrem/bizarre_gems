theme_override_colors/font_outline_color = Color(0, 0, 0, 0.25)

[node name="Count" type="Label" parent="TimeRow/Combo/VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Bold"
theme_override_font_sizes/font_size = 12
horizontal_alignment = 1
uppercase = true
visible = false

[node name="ComboBar" type="ProgressBar" parent="TimeRow/Combo/VBox"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(80, 4)
show_percentage = false

[connection signal="pressed" from="Top/Pause" to="." method="_on_pause_pressed"]
[connection signal="pressed" from="Top/Restart" to="." method="_on_restart_pressed"]
[connection signal="pressed" from="Top/Hint" to="." method="_on_hint_pressed"]
[connection signal="pressed" from="Top/Settings" to="." method="_on_settings_pressed"]
