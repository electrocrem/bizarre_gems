[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/more.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_medal.png" id="2"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_chart.png" id="3"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_info.png" id="4"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_settings.png" id="5"]

[node name="More" type="PanelContainer"]
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"Title"
theme_override_font_sizes/font_size = 32
text = "more"

[node name="Achievements" type="Button" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
text = "achievements"
icon = ExtResource("2")
alignment = 0

[node name="Stats" type="Button" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
text = "stats_title"
icon = ExtResource("3")
alignment = 0

[node name="Rules" type="Button" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
text = "how_title"
icon = ExtResource("4")
alignment = 0

[node name="Settings" type="Button" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
text = "settings"
icon = ExtResource("5")
alignment = 0

[node name="CloseRow" type="HFlowContainer" parent="VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Close" type="Button" parent="VBox/CloseRow"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"PrimaryButton"
text = "close"

[connection signal="pressed" from="VBox/Achievements" to="." method="_on_achievements_pressed"]
[connection signal="pressed" from="VBox/Stats" to="." method="_on_stats_pressed"]
[connection signal="pressed" from="VBox/Rules" to="." method="_on_rules_pressed"]
[connection signal="pressed" from="VBox/Settings" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="VBox/CloseRow/Close" to="." method="_on_close_pressed"]
