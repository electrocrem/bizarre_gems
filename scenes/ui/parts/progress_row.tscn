[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/progress_row.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_medal.png" id="2"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_crystal.png" id="3"]

[node name="ProgressRow" type="HBoxContainer"]
script = ExtResource("1")
theme_override_constants/separation = 10

[node name="Icon" type="TextureRect" parent="."]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(28, 28)
size_flags_vertical = 4
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 5
visible = false

[node name="Info" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3

[node name="Name" type="Label" parent="Info"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Body"
theme_override_font_sizes/font_size = 18
autowrap_mode = 3
size_flags_horizontal = 3

[node name="Bar" type="ProgressBar" parent="Info"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 8)
show_percentage = false

[node name="Done" type="Label" parent="."]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Bold"
theme_override_colors/font_color = Color(0.3608, 0.7843, 0.4784, 1)
theme_override_font_sizes/font_size = 26
text = "✓"
visible = false

[node name="Claim" type="Button" parent="."]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"PrimaryButton"
icon = ExtResource("3")
visible = false
theme_override_font_sizes/font_size = 15

[node name="Count" type="Label" parent="."]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Number"
theme_override_colors/font_color = Color(0.6667, 0.7216, 0.9255, 1)
theme_override_font_sizes/font_size = 18
visible = false

[connection signal="pressed" from="Claim" to="." method="_on_claim_pressed"]
