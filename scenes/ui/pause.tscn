[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/pause.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_play.png" id="2"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_home.png" id="3"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_settings.png" id="4"]

[node name="Pause" type="PanelContainer"]
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"Title"
theme_override_font_sizes/font_size = 40
text = "paused"
horizontal_alignment = 1

[node name="Buttons" type="HFlowContainer" parent="VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Resume" type="Button" parent="VBox/Buttons"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"PrimaryButton"
text = "resume"
icon = ExtResource("2")

[node name="Menu" type="Button" parent="VBox/Buttons"]
layout_mode = 2
unique_name_in_owner = true
text = "menu"
icon = ExtResource("3")

[node name="Settings" type="Button" parent="VBox/Buttons"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"IconButton"
icon = ExtResource("4")
custom_minimum_size = Vector2(52, 52)
icon_alignment = 1

[connection signal="pressed" from="VBox/Buttons/Resume" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="VBox/Buttons/Menu" to="." method="_on_menu_pressed"]
[connection signal="pressed" from="VBox/Buttons/Settings" to="." method="_on_settings_pressed"]
