[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/leaders.gd" id="1"]

[node name="Leaders" type="PanelContainer"]
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"Title"
theme_override_font_sizes/font_size = 36
text = "leaders"
horizontal_alignment = 1

[node name="Tabs" type="HFlowContainer" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
alignment = 1
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6

[node name="Score" type="Button" parent="VBox/Tabs"]
layout_mode = 2
text = "lb_score"
theme_override_font_sizes/font_size = 15

[node name="Bright" type="Button" parent="VBox/Tabs"]
layout_mode = 2
text = "lb_score_bright"
theme_override_font_sizes/font_size = 15

[node name="Zen" type="Button" parent="VBox/Tabs"]
layout_mode = 2
text = "lb_score_zen"
theme_override_font_sizes/font_size = 15

[node name="Stars" type="Button" parent="VBox/Tabs"]
layout_mode = 2
text = "lb_stars"
theme_override_font_sizes/font_size = 15

[node name="Status" type="Label" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Muted"
autowrap_mode = 3
size_flags_horizontal = 3

[node name="Scroll" type="ScrollContainer" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="VBox/Scroll"]
layout_mode = 2
unique_name_in_owner = true
theme_override_constants/separation = 6
size_flags_horizontal = 3

[node name="Login" type="Button" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
text = "login"
visible = false

[node name="CloseRow" type="HFlowContainer" parent="VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Close" type="Button" parent="VBox/CloseRow"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"PrimaryButton"
text = "close"

[connection signal="pressed" from="VBox/Login" to="." method="_on_login_pressed"]
[connection signal="pressed" from="VBox/CloseRow/Close" to="." method="_on_close_pressed"]
