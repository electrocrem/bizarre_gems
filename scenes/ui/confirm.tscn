[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/confirm.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_play.png" id="2"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_door.png" id="3"]

[node name="Confirm" type="PanelContainer"]
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"Title"
theme_override_font_sizes/font_size = 32
text = "leave_title"
horizontal_alignment = 1

[node name="Line" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"Muted"
text = "leave_line"
horizontal_alignment = 1
autowrap_mode = 3
size_flags_horizontal = 3

[node name="Buttons" type="HFlowContainer" parent="VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Stay" type="Button" parent="VBox/Buttons"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"PrimaryButton"
text = "stay"
icon = ExtResource("2")

[node name="Leave" type="Button" parent="VBox/Buttons"]
layout_mode = 2
unique_name_in_owner = true
text = "leave"
icon = ExtResource("3")

[connection signal="pressed" from="VBox/Buttons/Stay" to="." method="_on_stay_pressed"]
[connection signal="pressed" from="VBox/Buttons/Leave" to="." method="_on_leave_pressed"]
