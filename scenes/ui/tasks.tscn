[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/tasks.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_crystal.png" id="2"]

[node name="Tasks" type="PanelContainer"]
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Head" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="VBox/Head"]
layout_mode = 2
theme_type_variation = &"Title"
text = "tasks"
size_flags_horizontal = 3

[node name="CrystalIcon" type="TextureRect" parent="VBox/Head"]
layout_mode = 2
custom_minimum_size = Vector2(24, 24)
size_flags_vertical = 4
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 5
modulate = Color(0.498, 0.8471, 1, 1)

[node name="Crystals" type="Label" parent="VBox/Head"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Crystals"
text = "0"

[node name="List" type="VBoxContainer" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_override_constants/separation = 10

[node name="CloseRow" type="HFlowContainer" parent="VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Close" type="Button" parent="VBox/CloseRow"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"PrimaryButton"
text = "close"

[connection signal="pressed" from="VBox/CloseRow/Close" to="." method="_on_close_pressed"]
