[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/stats.gd" id="1"]

[node name="Stats" type="PanelContainer"]
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"Title"
theme_override_font_sizes/font_size = 32
text = "stats_title"

[node name="Grid" type="GridContainer" parent="VBox"]
layout_mode = 2
columns = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 8

[node name="GamesName" type="Label" parent="VBox/Grid"]
layout_mode = 2
theme_type_variation = &"Muted"
theme_override_font_sizes/font_size = 18
text = "stat_games"
size_flags_horizontal = 3

[node name="Games" type="Label" parent="VBox/Grid"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Number"
theme_override_font_sizes/font_size = 19
text = "0"
horizontal_alignment = 2
auto_translate_mode = 2

[node name="FavName" type="Label" parent="VBox/Grid"]
layout_mode = 2
theme_type_variation = &"Muted"
