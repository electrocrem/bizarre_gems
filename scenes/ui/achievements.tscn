[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/achievements.gd" id="1"]

[node name="Achievements" type="PanelContainer"]
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"Title"
theme_override_font_sizes/font_size = 32
text = "achievements"

[node name="Scroll" type="ScrollContainer" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 360)
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="VBox/Scroll"]
layout_mode = 2
unique_name_in_owner = true
theme_override_constants/separation = 8
size_flags_horizontal = 3

[node name="CloseRow" type="HFlowContainer" parent="VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Close" type="Button" parent="VBox/CloseRow"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"PrimaryButton"
text = "close"

[connection signal="pressed" from="VBox/CloseRow/Close" to="." method="_on_close_pressed"]
