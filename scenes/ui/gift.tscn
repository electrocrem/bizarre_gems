[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/gift.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_gift.png" id="2"]

[node name="Gift" type="PanelContainer"]
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"Title"
theme_override_font_sizes/font_size = 32
text = "gift_title"

[node name="Days" type="HFlowContainer" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
alignment = 1
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6

[node name="Line" type="Label" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Muted"
horizontal_alignment = 1
autowrap_mode = 3
size_flags_horizontal = 3

[node name="Buttons" type="HFlowContainer" parent="VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Take" type="Button" parent="VBox/Buttons"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"PrimaryButton"
text = "take"
icon = ExtResource("2")

[node name="Close" type="Button" parent="VBox/Buttons"]
layout_mode = 2
unique_name_in_owner = true
text = "close"

[connection signal="pressed" from="VBox/Buttons/Take" to="." method="_on_take_pressed"]
[connection signal="pressed" from="VBox/Buttons/Close" to="." method="_on_close_pressed"]
