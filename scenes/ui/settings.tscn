[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/settings.gd" id="1"]

[node name="Settings" type="PanelContainer"]
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"Title"
theme_override_font_sizes/font_size = 36
text = "settings"
horizontal_alignment = 1

[node name="SoundRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Sound" type="CheckButton" parent="VBox/SoundRow"]
layout_mode = 2
unique_name_in_owner = true
text = "sounds"
size_flags_horizontal = 3

[node name="SoundVolume" type="HSlider" parent="VBox/SoundRow"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 36)
size_flags_vertical = 4
max_value = 1.0
step = 0.05

[node name="MusicRow" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Music" type="CheckButton" parent="VBox/MusicRow"]
layout_mode = 2
unique_name_in_owner = true
text = "music_opt"
size_flags_horizontal = 3

[node name="MusicVolume" type="HSlider" parent="VBox/MusicRow"]
layout_mode = 2
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 36)
size_flags_vertical = 4
max_value = 1.0
step = 0.05

[node name="Vibration" type="CheckButton" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
text = "vibration"
size_flags_horizontal = 3

[node name="CloseRow" type="HFlowContainer" parent="VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Close" type="Button" parent="VBox/CloseRow"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"PrimaryButton"
text = "done"

[node name="ScaleInfo" type="Label" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Number"
theme_override_colors/font_color = Color(0.6667, 0.7216, 0.9255, 1)
theme_override_font_sizes/font_size = 12
auto_translate_mode = 2

[connection signal="toggled" from="VBox/SoundRow/Sound" to="." method="_on_sound_toggled"]
[connection signal="value_changed" from="VBox/SoundRow/SoundVolume" to="." method="_on_sound_volume_changed"]
[connection signal="drag_ended" from="VBox/SoundRow/SoundVolume" to="." method="_on_sound_volume_drag_ended"]
[connection signal="toggled" from="VBox/MusicRow/Music" to="." method="_on_music_toggled"]
[connection signal="value_changed" from="VBox/MusicRow/MusicVolume" to="." method="_on_music_volume_changed"]
[connection signal="drag_ended" from="VBox/MusicRow/MusicVolume" to="." method="_on_music_volume_drag_ended"]
[connection signal="toggled" from="VBox/Vibration" to="." method="_on_vibration_toggled"]
[connection signal="pressed" from="VBox/CloseRow/Close" to="." method="_on_close_pressed"]
