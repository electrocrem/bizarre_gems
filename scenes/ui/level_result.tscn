[ext_resource type="Texture2D" path="res://assets/ui/icon_map.png" id="6"]

[node name="LevelResult" type="PanelContainer"]
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Title"
theme_override_font_sizes/font_size = 40
horizontal_alignment = 1

[node name="Outcome" type="Label" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Bold"
theme_override_font_sizes/font_size = 22
horizontal_alignment = 1

[node name="Stars" type="HBoxContainer" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_override_constants/separation = 14
alignment = 1

[node name="Star0" type="TextureRect" parent="VBox/Stars"]
layout_mode = 2
custom_minimum_size = Vector2(64, 64)
size_flags_vertical = 4
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 5
modulate = Color(0.25, 0.3, 0.5, 1)

[node name="Star1" type="TextureRect" parent="VBox/Stars"]
layout_mode = 2
custom_minimum_size = Vector2(64, 64)
size_flags_vertical = 4
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 5
modulate = Color(0.25, 0.3, 0.5, 1)

[node name="Star2" type="TextureRect" parent="VBox/Stars"]
layout_mode = 2
custom_minimum_size = Vector2(64, 64)
size_flags_vertical = 4
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 5
modulate = Color(0.25, 0.3, 0.5, 1)

[node name="Line" type="Label" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
theme_type_variation = &"Muted"
horizontal_alignment = 1
autowrap_mode = 3
size_flags_horizontal = 3

[node name="Continue" type="Button" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
icon = ExtResource("3")

[node name="Double" type="Button" parent="VBox"]
layout_mode = 2
unique_name_in_owner = true
icon = ExtResource("3")

[node name="Buttons" type="HFlowContainer" parent="VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Next" type="Button" parent="VBox/Buttons"]
layout_mode = 2
unique_name_in_owner = true
