text = "next"
icon = ExtResource("4")

[node name="Retry" type="Button" parent="VBox/Buttons"]
layout_mode = 2
unique_name_in_owner = true
text = "again"
icon = ExtResource("5")

[node name="Map" type="Button" parent="VBox/Buttons"]
layout_mode = 2
unique_name_in_owner = true
text = "map"
icon = ExtResource("6")

[connection signal="pressed" from="VBox/Continue" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="VBox/Double" to="." method="_on_double_pressed"]
[connection signal="pressed" from="VBox/Buttons/Next" to="." method="_on_next_pressed"]
[connection signal="pressed" from="VBox/Buttons/Retry" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="VBox/Buttons/Map" to="." method="_on_map_pressed"]
