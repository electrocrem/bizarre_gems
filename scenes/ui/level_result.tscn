[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/level_result.gd" id="1"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_star.png" id="2"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_video.png" id="3"]
[ext_resource type="Texture2D" path="res://assets/ui/icon_play.png" id="4"]
